<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>// Place global declarations here.
const int N = 3;

const int R[N] = {0, 2, 4};
const int D[N] = {8, 4, 11};

bool released[N];
bool started[N];

urgent chan start[N];
chan finish[N];</declaration>
	<template>
		<name>CPU</name>
		<declaration>int current = -1;
bool t1_done = false;</declaration>
		<location id="id0" x="-255" y="-85">
			<name x="-265" y="-119">Free</name>
		</location>
		<location id="id1" x="0" y="-85">
			<name x="-25" y="-119">Busy</name>
		</location>
		<init ref="id0"/>
		<transition id="id2">
			<source ref="id1"/>
			<target ref="id0"/>
			<label kind="guard" x="-170" y="0">current &gt;=0</label>
			<label kind="synchronisation" x="-170" y="17">finish[current]?</label>
			<label kind="assignment" x="-161" y="34">current == -1</label>
			<nail x="-119" y="-9"/>
		</transition>
		<transition id="id3">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="select" x="-306" y="-246">i : int[0,N-1]</label>
			<label kind="guard" x="-484" y="-221">released[i] &amp;&amp;
!started[i] &amp;&amp;
forall (j : int[0,N-1])
    (!released[j] || started[j] || D[i] &lt;= D[j])</label>
			<label kind="synchronisation" x="-42" y="-195">start[i]?</label>
			<label kind="assignment" x="-51" y="-212">current = i</label>
			<nail x="-128" y="-263"/>
		</transition>
	</template>
	<template>
		<name x="5" y="5">Task</name>
		<parameter>int id, int minExec, int maxExec</parameter>
		<declaration>// Place local declarations here.
clock d;
clock x;</declaration>
		<location id="id4" x="-467" y="-229">
			<name x="-477" y="-263">Ready</name>
		</location>
		<location id="id5" x="-195" y="-229">
			<name x="-205" y="-263">Running</name>
			<label kind="invariant" x="-238" y="-289">x &lt;= maxExec</label>
		</location>
		<location id="id6" x="-8" y="-119">
			<name x="-18" y="-153">Finished</name>
		</location>
		<location id="id7" x="-85" y="25">
			<name x="-153" y="0">Missed</name>
		</location>
		<location id="id8" x="-960" y="-229">
			<name x="-970" y="-263">NotReleased</name>
			<label kind="invariant" x="-1028" y="-212">d &lt;= R[id]</label>
		</location>
		<init ref="id8"/>
		<transition id="id9">
			<source ref="id8"/>
			<target ref="id4"/>
			<label kind="guard" x="-773" y="-297">d &gt;= R[id]</label>
			<label kind="assignment" x="-773" y="-263">released[id] = true</label>
		</transition>
		<transition id="id10">
			<source ref="id5"/>
			<target ref="id7"/>
			<label kind="guard" x="-289" y="-102">x &gt;= minExec &amp;&amp; d &gt; D[id]</label>
			<label kind="synchronisation" x="-229" y="-76">finish[id]!</label>
		</transition>
		<transition id="id11">
			<source ref="id5"/>
			<target ref="id6"/>
			<label kind="guard" x="-76" y="-187">x &gt;= minExec &amp;&amp; d &lt;= D[id]</label>
			<label kind="synchronisation" x="-85" y="-204">finish[id]!</label>
		</transition>
		<transition id="id12">
			<source ref="id4"/>
			<target ref="id5"/>
			<label kind="synchronisation" x="-416" y="-220">start[id]!</label>
			<label kind="assignment" x="-416" y="-195">x = 0 ,
started[id] = true</label>
		</transition>
	</template>
	<system>T0 = Task(0, 2, 3);
T1 = Task(1, 1, 2);
T2 = Task(2, 2, 3);

cpu = CPU();

system T0, T1, T2, cpu;</system>
	<queries>
		<query>
			<formula>E&lt;&gt; T0.Finished</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-09-10 13:51:26 +0330">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; T1.Finished</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-09-10 13:51:29 +0330">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; T2.Finished</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-09-10 13:51:32 +0330">
			</result>
		</query>
		<query>
			<formula>A[] not (T0.Missed || T1.Missed || T2.Missed)</formula>
			<comment/>
			<option key="--diagnostic" value="1"/>
			<result outcome="failure" type="quality" timestamp="2026-09-10 14:19:57 +0330">
				<option key="--diagnostic" value="1"/>
			</result>
		</query>
		<query>
			<formula>A[] not deadlock</formula>
			<comment/>
			<result outcome="failure" type="quality" timestamp="2026-09-10 13:51:41 +0330">
			</result>
		</query>
	</queries>
</nta>
